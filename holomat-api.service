[Unit]
Description=Holomat API Server (JARVIS)
After=network-online.target smbd.service
Wants=network-online.target

[Service]
Type=simple
User=jarvis
WorkingDirectory=/home/jarvis/holomat-api
ExecStartPre=/home/jarvis/holomat-api/scripts/pre_start.sh
ExecStart=/home/jarvis/holomat-api/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8100 --log-level warning
Restart=on-failure
RestartSec=5

# ── Generic defaults (override via .env or a systemd drop-in) ───────────────
Environment=ORCA_CLI=/usr/bin/orca-slicer
Environment=OPENSCAD_BIN=openscad
Environment=CAMERA_DEVICE=0
Environment=HA_MQTT_PORT=1883
Environment=BAMBU_REGION=global

# ── Host-specific config & secrets — NOT committed ──────────────────────────
# Configure via the Settings UI (http://<host>:8100/settings → saved to .env),
# or a systemd drop-in:  sudo systemctl edit holomat-api
# The .env file takes priority over Environment= lines (override=True).
# Keys to set:
#   GEMINI_API_KEY, CF_API_URL, CF_API_KEY
#   BAMBU_SERIAL, BAMBU_IP, BAMBU_ACCESS_CODE, BAMBU_EMAIL, BAMBU_PASSWORD
#   HA_URL, HA_MQTT_HOST, HA_MQTT_USER, HA_MQTT_PASS, HA_TOKEN

[Install]
WantedBy=multi-user.target

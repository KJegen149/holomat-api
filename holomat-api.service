[Unit]
Description=Holomat API Server (JARVIS Holomat v0.3.0)
After=network-online.target smbd.service
Wants=network-online.target

[Service]
Type=simple
User=jarvis
WorkingDirectory=/home/jarvis/holomat-api
ExecStartPre=/home/jarvis/holomat-api/scripts/pre_start.sh
ExecStart=/home/jarvis/holomat-api/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8100 --log-level warning
Restart=on-failure
RestartSec=5

# ── Bambu P1S printer ──────────────────────────────────────────────────────
Environment=BAMBU_IP=10.11.12.91
Environment=BAMBU_ACCESS_CODE=14620600
Environment=BAMBU_SERIAL=01p00c5c0701414
Environment=BAMBU_CERT=/home/jarvis/holomat-api/certs/printer.pem

# ── Cloudflare edge layer ──────────────────────────────────────────────────
Environment=CF_API_URL=https://jarvis-api.kjeg.workers.dev
# Set CF_API_KEY after install:
#   sudo systemctl edit holomat-api
#   Add under [Service]: Environment=CF_API_KEY=your_key_here
Environment=CF_API_KEY=

# ── Local tool paths ───────────────────────────────────────────────────────
Environment=ORCA_CLI=/usr/bin/orca-slicer
Environment=OPENSCAD_BIN=openscad

# ── Camera (Phase 1+) ──────────────────────────────────────────────────────
Environment=CAMERA_DEVICE=0

# ── Home Assistant (Phase 3) ──────────────────────────────────────────────
Environment=HA_URL=https://ha.nannerserver.com
Environment=HA_MQTT_HOST=                       # REQUIRED — set to your Mosquitto broker IP
Environment=HA_MQTT_PORT=1883
Environment=HA_MQTT_USER=Jarvis_Holomat
Environment=HA_MQTT_PASS=                       # REQUIRED — set to Jarvis_Holomat password

# ── Object ID — GPT-4o Vision (Phase 4) ───────────────────────────────────
# Set after install: sudo systemctl edit holomat-api
Environment=OPENAI_API_KEY=

[Install]
WantedBy=multi-user.target

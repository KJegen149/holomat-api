# Holomat — environment variable reference
# Copy relevant lines into: sudo systemctl edit holomat-api
# Then add under [Service]:  Environment=KEY=value

# ── Bambu P1S ──────────────────────────────────────────────────────────────
BAMBU_SERIAL=01P00C5C0701414

# Cloud mode (preferred — auto-starts print, no touchscreen confirmation):
# Printer must be in normal/hybrid mode (NOT LAN-only mode).
BAMBU_EMAIL=                          # REQUIRED for cloud mode — Bambu account email
BAMBU_PASSWORD=                       # REQUIRED for cloud mode — Bambu account password
BAMBU_REGION=global                   # "global" or "china"
# BAMBU_TOKEN_FILE=scan_data/.bambu_token  # token cache (default, no need to set)

# LAN fallback (touchscreen confirmation required — used if cloud creds not set):
BAMBU_IP=10.11.12.91
BAMBU_ACCESS_CODE=14620600
BAMBU_CERT=/home/jarvis/holomat-api/certs/printer.pem

# ── Home Assistant (Phase 3) ───────────────────────────────────────────────
HA_URL=https://ha.nannerserver.com              # HA URL for iframe embed in JARVIS UI
HA_MQTT_HOST=                                   # REQUIRED — Mosquitto broker IP/hostname
HA_MQTT_PORT=1883                               # default 1883
HA_MQTT_USER=                                   # optional MQTT username
HA_MQTT_PASS=                                   # optional MQTT password

# ── Cloudflare ─────────────────────────────────────────────────────────────
CF_API_URL=https://jarvis-api.kjeg.workers.dev
CF_API_KEY=                         # REQUIRED — set after install

# ── Local tools ────────────────────────────────────────────────────────────
ORCA_CLI=/usr/bin/orca-slicer
OPENSCAD_BIN=openscad

# ── Camera (Phase 1+) ──────────────────────────────────────────────────────
CAMERA_DEVICE=0                     # /dev/video0

# ── Object identification — Gemini Vision (Phase 4) ───────────────────────
GEMINI_API_KEY=                     # REQUIRED for Phase 4
GEMINI_MODEL=gemini-2.5-flash       # optional override; default gemini-2.5-flash

# ── Wyoming voice bridge (Phase 8) ────────────────────────────────────────
WYOMING_ENABLED=false               # Set to "true" to activate voice bridge
WYOMING_STT_PORT=10300              # Wyoming STT server port (HA connects here for speech-to-text)
WYOMING_TTS_PORT=10200              # Wyoming TTS server port (HA connects here for text-to-speech)
WYOMING_STT_URL=https://wyoming-stt.kjeg.workers.dev
WYOMING_TTS_URL=https://wyoming-tts.kjeg.workers.dev
WYOMING_LLM_URL=https://wyoming-llm.kjeg.workers.dev
WYOMING_MIC_INDEX=                  # sounddevice mic device index (leave blank for system default)
WYOMING_SPEAKER_INDEX=              # sounddevice speaker device index (leave blank for system default)
WYOMING_WAKE_SENSITIVITY=0.5        # openWakeWord detection threshold (0.0–1.0; lower = more sensitive)
HA_TOKEN=                           # HA long-lived access token (Settings → Profile → Long-Lived Tokens)
                                    # REQUIRED for device state context and HA service execution

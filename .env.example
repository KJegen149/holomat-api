# Holomat — environment variable reference
#
# This is a TEMPLATE. Real values are never committed.
# Configure via the Settings UI (http://<host>:8100/settings → saved to .env),
# or copy lines into a systemd drop-in: sudo systemctl edit holomat-api
# then add under [Service]:  Environment=KEY=value

# ── Bambu P1S ──────────────────────────────────────────────────────────────
BAMBU_SERIAL=                         # printer serial (printer screen)

# Cloud mode (auto-starts print, no touchscreen confirmation).
# Printer must be in normal/hybrid mode (NOT LAN-only mode):
BAMBU_EMAIL=                          # Bambu account email
BAMBU_PASSWORD=                       # Bambu account password
BAMBU_REGION=global                   # "global" or "china"
# BAMBU_TOKEN_FILE=scan_data/.bambu_token  # token cache (default, no need to set)

# LAN mode (printer in LAN-only / Developer Mode):
BAMBU_IP=                             # printer LAN IP (printer screen -> WLAN)
BAMBU_ACCESS_CODE=                    # printer LAN access code (printer screen -> WLAN)
BAMBU_CERT=certs/printer.pem          # printer TLS certificate path

# ── Home Assistant ─────────────────────────────────────────────────────────
HA_URL=https://ha.example.com         # HA URL for iframe embed in JARVIS UI
HA_MQTT_HOST=                         # Mosquitto broker IP/hostname
HA_MQTT_PORT=1883
HA_MQTT_USER=                         # optional MQTT username
HA_MQTT_PASS=                         # optional MQTT password
HA_TOKEN=                             # HA long-lived access token (device control)

# ── Cloudflare ─────────────────────────────────────────────────────────────
CF_API_URL=https://your-worker.workers.dev
CF_API_KEY=                           # set after install

# ── Local tools ────────────────────────────────────────────────────────────
ORCA_CLI=/usr/bin/orca-slicer
OPENSCAD_BIN=openscad

# ── Camera ─────────────────────────────────────────────────────────────────
CAMERA_DEVICE=0                       # /dev/video0

# ── Object identification — Gemini Vision ──────────────────────────────────
GEMINI_API_KEY=                       # Google Gemini API key
GEMINI_MODEL=gemini-2.5-flash         # optional override; default gemini-2.5-flash

# ── Wyoming voice bridge ───────────────────────────────────────────────────
WYOMING_ENABLED=false                 # set "true" to activate the voice bridge
WYOMING_STT_PORT=10300                # Wyoming STT server port (HA connects here)
WYOMING_TTS_PORT=10200                # Wyoming TTS server port (HA connects here)
# WYOMING_STT_URL=                    # optional — overrides the built-in worker URL
# WYOMING_TTS_URL=                    # optional — overrides the built-in worker URL
# WYOMING_LLM_URL=                    # optional — overrides the built-in worker URL
WYOMING_MIC_INDEX=                    # sounddevice mic index (blank = system default)
WYOMING_SPEAKER_INDEX=                # sounddevice speaker index (blank = system default)
WYOMING_WAKE_SENSITIVITY=0.5          # openWakeWord threshold (0.0-1.0)
